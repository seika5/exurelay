PORT=4000
# Behind Caddy (deploy/Caddyfile), bind to loopback so only the TLS proxy can reach the API.
HOST=127.0.0.1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public https URL of this server, exactly as in your join code (e.g. https://relay.example.com).
# Logins signed for any other server are refused. Leave empty only for local testing.
PUBLIC_URL=

# First admin's signing public key (comma-separated for several). Copy it from the app's "Set up a new server"
# screen. It only authorizes the first member list; after that, the admins listed in the newest list are trusted.
ADMIN_SIGNING_KEYS=

# Anonymous tokens each member may get per minute, after a burst of TOKEN_BURST. One token pays for one request
# (send, sync, TURN). There's no daily cap; this only stops one member flooding the server.
TOKEN_RATE_PER_MINUTE=30
TOKEN_BURST=200

# TURN (deploy/turnserver.conf). TURN_SECRET must equal coturn's static-auth-secret.
# Generate with: openssl rand -hex 32
TURN_SECRET=
TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349?transport=tcp
STUN_URLS=stun:relay.example.com:3478
# How long issued TURN credentials stay valid (seconds). Default 12h.
TURN_TTL_SECONDS=43200

# Push notifications for @mentions and call rings (optional). Make a key pair with: npm run vapid
# The subject is how push services can reach you about problems (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@relay.example.com
