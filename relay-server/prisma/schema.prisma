// Zero-knowledge: no senderId, recipientId, or sentAt.
// Server stores only encrypted blobs and expiry; every member downloads every blob (protocol v2, DESIGN.md §5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enrolled members, mirrored from the newest admin-signed directory (Directory below).
// Public keys are kept so the server can check signatures (profiles and logins).
model Member {
  keyHash          String   @id
  ecdhPublicKey    String
  signingPublicKey String   @unique
  enrolledAt       DateTime
}

// Admin-signed member directories. body is the exact signed JSON string; clients verify it themselves.
// Only the newest is served, but older ones are kept so the version can only go up.
model Directory {
  version   Int      @id
  body      String
  signature String
  createdAt DateTime @default(now())
}

// Each member's self-signed display name. Newest updatedAt wins.
model Profile {
  keyHash   String @id
  body      String
  signature String
  updatedAt BigInt
}

// Encrypted blobs: no sender, no recipient, no sentAt. seq is the sync cursor (GET /api/blobs?since=).
model Blob {
  seq       BigInt   @id @default(autoincrement())
  payload   Bytes
  expiresAt DateTime

  @@index([expiresAt])
}

// RFC 9474 issuer keys for anonymous tokens (src/lib/tokens.js). reason is "daily" or "removal".
// Private keys sit here so they survive restarts; anyone with a database dump could mint tokens until notAfter.
model IssuerKey {
  id               String   @id
  publicKey        Bytes
  privateKey       Bytes
  reason           String
  notBefore        DateTime
  notAfter         DateTime
  directoryVersion Int?
  createdAt        DateTime @default(now())

  @@unique([reason, notBefore])
}

// Hashes of spent tokens, kept until their issuer key expires. Not linked to any member.
model SpentToken {
  hash      String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// Admin-only labels for members ("Mum's phone"). Never sent to non-admins.
model AdminLabel {
  keyHash String @id
  label   String
}

// A member's own signed "I'm leaving" (DESIGN.md §3). Their Member row is deleted at once; this stays until an
// admin publishes a directory without them, so clients can verify the departure and drop them meanwhile.
model Departure {
  keyHash   String @id
  body      String
  signature String
}
