// Zero-knowledge: no senderId, recipientId, or sentAt.
// Server stores only encrypted blobs and expiry; addressing by public key hash.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enrolled members, mirrored from the newest admin-signed directory (Directory below).
// Public keys are kept so the server can check signatures (profiles now, logins in phase 3).
model Member {
  keyHash          String   @id
  ecdhPublicKey    String
  signingPublicKey String   @unique
  enrolledAt       DateTime
}

// Admin-signed member directories. body is the exact signed JSON string; clients verify it themselves.
// Only the newest is served, but older ones are kept so the version can only go up.
model Directory {
  version   Int      @id
  body      String
  signature String
  createdAt DateTime @default(now())
}

// Each member's self-signed display name. Newest updatedAt wins.
model Profile {
  keyHash   String @id
  body      String
  signature String
  updatedAt BigInt
}

// Encrypted blobs. Addressed by recipient key hash only; no sender or sentAt.
model Blob {
  id               String   @id @default(cuid())
  recipientKeyHash String
  payload          Bytes
  expiresAt        DateTime

  @@index([recipientKeyHash])
  @@index([expiresAt])
}
