// Zero-knowledge: no senderId, recipientId, or sentAt.
// Server stores only encrypted blobs and expiry; every member downloads every blob (protocol v2, DESIGN.md §5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enrolled members, mirrored from the newest admin-signed directory (Directory below).
// Public keys are kept so the server can check signatures (profiles and logins).
model Member {
  keyHash          String   @id
  ecdhPublicKey    String
  signingPublicKey String   @unique
  enrolledAt       DateTime
}

// Admin-signed member directories. body is the exact signed JSON string; clients verify it themselves.
// Only the newest is served, but older ones are kept so the version can only go up.
model Directory {
  version   Int      @id
  body      String
  signature String
  createdAt DateTime @default(now())
}

// A member's sealed profile for one recipient device (lib/profiles.js): their display name, plus device names when
// the recipient is one of their own devices, encrypted by one of their devices (`sender`). Unreadable here.
model ProfileCopy {
  author     String
  recipient  String
  sender     String
  nonce      String
  ciphertext String
  updatedAt  BigInt

  @@id([author, recipient])
  @@index([recipient])
}

// Encrypted blobs: no sender, no recipient, no sentAt. seq is the sync cursor (GET /api/blobs?since=).
model Blob {
  seq       BigInt   @id @default(autoincrement())
  payload   Bytes
  expiresAt DateTime

  @@index([expiresAt])
}

// RFC 9474 issuer keys for anonymous tokens (src/lib/tokens.js). reason is "daily" or "removal".
// Private keys sit here so they survive restarts; anyone with a database dump could mint tokens until notAfter.
model IssuerKey {
  id               String   @id
  publicKey        Bytes
  privateKey       Bytes
  reason           String
  notBefore        DateTime
  notAfter         DateTime
  directoryVersion Int?
  createdAt        DateTime @default(now())

  @@unique([reason, notBefore])
}

// Hashes of spent tokens, kept until their issuer key expires. Not linked to any member.
model SpentToken {
  hash      String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// A member's own signed "I'm leaving" (DESIGN.md §3). Their Member row is deleted at once; this stays until an
// admin publishes a directory without them, so clients can verify the departure and drop them meanwhile.
model Departure {
  keyHash   String @id
  body      String
  signature String
}

// A member's other devices (linked devices, DESIGN.md §4): each has its own keys, certified by one of the member's
// devices. Deleted when the member is removed or leaves.
model Device {
  keyHash          String @id
  member           String
  ecdhPublicKey    String
  signingPublicKey String @unique
  body             String
  signature        String

  @@index([member])
}

// Signed unlinks, so clients can verify them and an unlinked device key can't be certified again.
model DeviceRevocation {
  keyHash   String @id
  member    String
  body      String
  signature String

  @@index([member])
}

// Web Push subscriptions (DESIGN.md §9 "direct push (A)"), one per device that turned notifications on. Only used to
// deliver @mentions and call rings; who was notified, or when, is never recorded.
model PushSubscription {
  endpoint String @id
  device   String
  member   String
  p256dh   String
  auth     String
  /// Notify for every message and call start too, not only @mentions and rings (if the admin allows it).
  all      Boolean @default(false)

  @@index([device])
  @@index([member])
}
